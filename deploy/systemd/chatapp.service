[Unit]
Description=LLM chat (Flask + Gunicorn)
After=network.target mysql.service ollama.service
Wants=mysql.service ollama.service

[Service]
User=chatapp
Group=chatapp
WorkingDirectory=/opt/chatapp/app
EnvironmentFile=/etc/chatapp/chatapp.env
# systemd creates /run/chatapp, where Gunicorn makes its Unix socket.
RuntimeDirectory=chatapp
RuntimeDirectoryMode=0755
# gthread workers: long streaming requests do not block the whole service
ExecStart=/opt/chatapp/venv/bin/gunicorn \
    --workers 2 --worker-class gthread --threads 8 \
    --timeout 300 \
    --bind unix:/run/chatapp/gunicorn.sock --umask 007 \
    --access-logfile - \
    app:app
Restart=on-failure
RestartSec=3

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target